# Copiar apenas para /home/deploy/cupcake-staging/.env (chmod 0600, owner deploy).
# Preencher valores reais na VPS. A região S3 deve ser confirmada com o administrador do MinIO.
POSTGRES_DB=cupcake_staging
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
S3_ENDPOINT=https://api.s3.qosit.cloud
S3_REGION=
S3_BUCKET=cupcake-staging-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
API_BASE_URL=http://api:3000
APP_PUBLIC_URL=https://app-staging.qosit.cloud
API_IMAGE=ghcr.io/diegoromal/cupcake-api@sha256:<API_DIGEST>
OPS_IMAGE=ghcr.io/diegoromal/cupcake-api@sha256:<OPS_DIGEST>
ADMIN_IMAGE=ghcr.io/diegoromal/cupcake-admin@sha256:<ADMIN_DIGEST>
