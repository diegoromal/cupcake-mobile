# PostgreSQL local usado pelo Docker Compose
POSTGRES_DB=cupcake
POSTGRES_USER=cupcake
POSTGRES_PASSWORD=cupcake_local_password
POSTGRES_PORT=5432

# URL a ser usada pela API em desafio posterior. Mantenha-a compatível com os valores acima.
DATABASE_URL=postgresql://cupcake:cupcake_local_password@localhost:5432/cupcake?schema=public

# Segredos distintos e obrigatórios para os JWT da API. Defina valores fortes fora do repositório.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Storage local S3Mock; use credenciais distintas em ambientes reais.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=cupcake-images
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev
S3_FORCE_PATH_STYLE=true

# Chave privada do backend para geocodificação forward (Geocode.Maps.co).
GEOCODE_MAPS_CO_API_KEY=

# Evolution API v2 para envio de mensagens WhatsApp. Necessário somente ao enviar.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=
